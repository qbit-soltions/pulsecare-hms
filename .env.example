# =============================================================================
# PulseCare Hospital Management System - Environment Variables
# =============================================================================

# Flask Application Settings
SECRET_KEY=pulsecare-publichealth-2026-secure-key
FLASK_ENV=development
DEBUG=True

# -----------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Option 1: Direct PostgreSQL Connection URI (From Supabase Dashboard -> Project Settings -> Database -> Connection URI)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or Session Pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Option 2: Supabase API URL & Anon / Service Role API Key
# (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI FREE API KEY (OPTIONAL - FOR ADVANCED REAL-TIME VOICE AI)
# Get a 100% Free API Key from: https://aistudio.google.com/
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# AYUSHMAN BHARAT DIGITAL MISSION (ABDM) SANDBOX CREDENTIALS (OPTIONAL)
# -----------------------------------------------------------------------------
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_SANDBOX_MODE=true

